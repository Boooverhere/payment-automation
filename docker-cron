# Payment Automation — runs every hour at :00
0 * * * * root cd /app && /usr/local/bin/python3 app.py >> /proc/1/fd/1 2>/proc/1/fd/2

# Abandoned checkout checker — runs every hour at :30
30 * * * * root cd /app && /usr/local/bin/python3 check_abandoned.py >> /proc/1/fd/1 2>/proc/1/fd/2

# Required empty line at end of crontab
