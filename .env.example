# WooCommerce
WC_STORE_URL=https://yourstore.com
WC_CONSUMER_KEY=ck_xxxx
WC_CONSUMER_SECRET=cs_xxxx

# Google Sheets
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_NAME=Payment Tracker

# Email sender
SENDER_EMAIL=contact@yourdomain.com
SENDER_NAME=Your Company Name
SMTP_LOGIN=your-brevo-login@email.com
SMTP_PASSWORD=your-smtp-key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465

# Webhook (copy this secret into WooCommerce webhook settings)
WEBHOOK_SECRET=generate-a-strong-random-secret-here
WEBHOOK_PORT=8000
